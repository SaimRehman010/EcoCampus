# ==============================================================================
# EcoCampus Unified Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Express.js Backend API (Port 5000)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/ecocampus
JWT_SECRET=ecocampus_development_jwt_secret_change_in_production
JWT_EXPIRE=7d

# Internal Microservice URLs
PYTHON_SERVICE_URL=http://localhost:5001
AI_SERVICE_URL=http://localhost:5002

# ------------------------------------------------------------------------------
# 2. Python Resource Analyzer Microservice (Port 5001)
# ------------------------------------------------------------------------------
PYTHON_PORT=5001
DEFAULT_RATE_PER_KWH=0.15

# ------------------------------------------------------------------------------
# 3. Python AI Microservice (RAG & Agent - Port 5002)
# ------------------------------------------------------------------------------
AI_PORT=5002
EXPRESS_BACKEND_URL=http://localhost:5000

# Optional LLM API Keys (Falls back to native built-in grounded RAG engine if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. React Frontend (Vite - Port 3000)
# ------------------------------------------------------------------------------
VITE_EXPRESS_URL=http://localhost:5000/api
VITE_PYTHON_URL=http://localhost:5001/api
VITE_AI_URL=http://localhost:5002/api/ai
